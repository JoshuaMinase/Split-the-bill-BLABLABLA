# Copy this file to .env and fill in your values
# Never commit .env to git

# Tier 1: Google Gemini 2.0 Flash (primary — free, 1,500 req/day)
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tier 2: OpenRouter (fallback — activates automatically on Gemini 429)
# Get free key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tier 3: Groq vision (last resort — comma-separate multiple keys for rotation)
# Get free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_1,your_groq_key_2,your_groq_key_3

# MongoDB connection string
# Option A: Local MongoDB (install https://www.mongodb.com/try/download/community)
MONGODB_URI=mongodb://localhost:27017
# Option B: Free Atlas cloud cluster (https://www.mongodb.com/cloud/atlas/register)
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=splitreceipt
