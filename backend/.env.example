# Copy this file to .env and fill in your values
# Never commit .env to git

# Get your Grok API key from https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# MongoDB connection string
# Option A: Local MongoDB (install https://www.mongodb.com/try/download/community)
MONGODB_URI=mongodb://localhost:27017
# Option B: Free Atlas cloud cluster (https://www.mongodb.com/cloud/atlas/register)
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=splitreceipt
