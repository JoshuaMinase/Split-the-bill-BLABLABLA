# frontend/.env.local
# ─────────────────────────────────────────────────────────────────────────────
# This file is intentionally excluded from git (.gitignore).
# Copy it and fill in the real values for your deployment.
#
# LOCAL DEV:  Leave this file empty — the frontend defaults to http://localhost:8000
# PRODUCTION: Set NEXT_PUBLIC_API_URL to your deployed Railway backend URL
# ─────────────────────────────────────────────────────────────────────────────

# Backend URL — no trailing slash
# Example: https://splitreceipt-backend-production.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000
