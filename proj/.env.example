# Example environment variables for SplitReceipt (frontend + server)
# Copy this to frontend/.env or set variables in Railway/hosting provider.

# Postgres (Prisma) connection string. Replace USER, PASS, HOST, PORT, DBNAME.
# Example: postgresql://dbuser:secret@db-host:5432/splitreceipt?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Public frontend -> backend base URL (optional in deployed single-app setups)
# In production, set to your deployed site URL, e.g. https://splitreceipt.example.com
NEXT_PUBLIC_API_URL="http://localhost:3000"

# AI provider keys — set at least one. Comma-separate multiple GROQ keys.
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# CORS / allowed origins for legacy FastAPI (if used)
ALLOWED_ORIGINS="*"

# Optional: control feature flags
# ENABLE_EDGE_UPLOAD=false  # set true to use Edge upload endpoint (limited)
