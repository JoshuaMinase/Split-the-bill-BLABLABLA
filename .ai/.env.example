# .ai/.env — API keys for the orchestration system
# Copy this file to .ai/.env and fill in your keys.
# This file is separate from backend/.env on purpose —
# the orchestrator keys are for agent tools, not the app.

# ── Gemini ──────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Devin ───────────────────────────────────────────────────
# Get a key at: https://app.devin.ai/settings/api
# Only needed if you use Devin via API (not CLI)
DEVIN_API_KEY=

# ── OpenCode ────────────────────────────────────────────────
# OpenCode is CLI-only — no API key needed
# Make sure `opencode` is in your PATH:
#   npm install -g opencode-ai

# ── KiloCode ────────────────────────────────────────────────
# KiloCode is a VS Code extension — no API key needed here
# CLI support depends on your installed version
